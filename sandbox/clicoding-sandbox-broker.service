[Unit]
Description=CLICoding approved sandbox execution broker
After=docker.service
Requires=docker.service

[Service]
Type=simple
RuntimeDirectory=clicoding-sandbox
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
User=root
Group=root
EnvironmentFile=/etc/cds-ai/sandbox-broker.env
ExecStart=/usr/bin/python3 /usr/local/libexec/clicoding-sandbox-broker.py
Restart=on-failure
RestartSec=2
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/clicoding-sandbox /run/lock /var/lib/cds-ai
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
