# Copy to /etc/cds-ai/orchestrator.env and protect it (root:cds-ai, mode 0640).
# Never commit real credentials or production worker endpoints.

CLICODING_DATABASE_PATH=/var/lib/cds-ai/clicoding.db
CLICODING_ATTACHMENT_STORAGE_DIR=/var/lib/cds-ai/attachments
CLICODING_WORKERS_FILE=/etc/cds-ai/workers.yaml

# Generate a unique random ASCII secret of at least 32 characters.
CLICODING_API_KEY=REPLACE_WITH_RANDOM_SECRET

# Keep specialist planning disabled until every configured worker is live-tested.
CLICODING_ENABLE_PLANNING=false
CLICODING_MAX_PARALLEL_TASKS=1
CLICODING_RATE_LIMIT_PER_WINDOW=120
CLICODING_RATE_LIMIT_WINDOW_SECONDS=60
CLICODING_TRUST_USER_HEADER=false
CLICODING_MAX_ATTACHMENT_BYTES=10485760
CLICODING_REQUEST_TIMEOUT_SECONDS=180
