# Bind the development server to 127.0.0.1 until LAN authentication/TLS is implemented.
CLICODING_DATABASE_PATH=./data/clicoding.db

# OpenAI-compatible upstream, e.g. a local vLLM or internal model gateway.
CLICODING_UPSTREAM_BASE_URL=http://127.0.0.1:8000/v1
CLICODING_UPSTREAM_MODEL=replace-with-served-model-alias
CLICODING_UPSTREAM_API_KEY=
CLICODING_REQUEST_TIMEOUT_SECONDS=180
