# Keep Uvicorn bound to 127.0.0.1 unless a bearer key and internal TLS are configured.
CLICODING_DATABASE_PATH=./data/clicoding.db

# Optional YAML registry. When set, this replaces legacy single-upstream settings.
# Copy config/workers.example.yaml to a private local workers.yaml first.
CLICODING_WORKERS_FILE=

# Backward-compatible single-worker mode (used when WORKERS_FILE is unset).
CLICODING_UPSTREAM_BASE_URL=http://127.0.0.1:8000/v1
CLICODING_UPSTREAM_MODEL=replace-with-served-model-alias
CLICODING_UPSTREAM_API_KEY=
CLICODING_REQUEST_TIMEOUT_SECONDS=180

# Optional inbound API bearer key. If set, all endpoints except /health require it.
# Use a long random secret; do not commit the real value.
CLICODING_API_KEY=

# Opt-in multi-model planning for both /v1/chat/completions and internal turn APIs.
CLICODING_ENABLE_PLANNING=false

# Up to three independent tasks can execute concurrently (one per resident runtime).
CLICODING_MAX_PARALLEL_TASKS=3

# Local, conversation-scoped image attachment storage (raster images only).
CLICODING_ATTACHMENT_STORAGE_DIR=./data/attachments
CLICODING_MAX_ATTACHMENT_BYTES=10485760
